{
  "info": {
    "name": "Credit Default Risk API",
    "description": "Public demo requests for the mentor evaluation. The temporary URL works only while FastAPI and cloudflared are running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://credit-default-risk-api-vivek.onrender.com"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Model loaded\", function () { pm.expect(pm.response.json().model_loaded).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Model info",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/model-info"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Measured metrics present\", function () { pm.expect(pm.response.json().test_metrics).to.have.property(\"accuracy\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict sample customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/predict",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"features\": {\n    \"LIMIT_BAL\": 20000,\n    \"SEX\": 2,\n    \"EDUCATION\": 2,\n    \"MARRIAGE\": 1,\n    \"AGE\": 24,\n    \"PAY_0\": 2,\n    \"PAY_2\": 2,\n    \"PAY_3\": -1,\n    \"PAY_4\": -1,\n    \"PAY_5\": -2,\n    \"PAY_6\": -2,\n    \"BILL_AMT1\": 3913,\n    \"BILL_AMT2\": 3102,\n    \"BILL_AMT3\": 689,\n    \"BILL_AMT4\": 0,\n    \"BILL_AMT5\": 0,\n    \"BILL_AMT6\": 0,\n    \"PAY_AMT1\": 0,\n    \"PAY_AMT2\": 689,\n    \"PAY_AMT3\": 0,\n    \"PAY_AMT4\": 0,\n    \"PAY_AMT5\": 0,\n    \"PAY_AMT6\": 0\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Probability is valid\", function () { const p = pm.response.json().default_probability; pm.expect(p).to.be.within(0,1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Optimize threshold",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/optimize-threshold",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"false_positive_cost\": 2000,\n  \"false_negative_cost\": 20000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Cost result present\", function () { pm.expect(pm.response.json()).to.have.property(\"optimal_threshold\"); });"
            ]
          }
        }
      ]
    }
  ]
}